{
  "model": "claude-sonnet-5-5",
  "permissions": {
    "defaultMode": "default",
    "deny": [
      "Bash(*rm -rf*)",
      "Bash(*rm -fr*)",
      "Bash(*rm -Rf*)",
      "Bash(*rm -fR*)",
      "Bash(*rm -r -f*)",
      "Bash(*rm -f -r*)",
      "Bash(*rm --recursive --force*)",
      "Bash(*rm --force --recursive*)"
    ]
  }
}
